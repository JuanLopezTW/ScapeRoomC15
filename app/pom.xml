<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>co.eci</groupId>
        <artifactId>escaperoom-c15</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>app</artifactId>
    <packaging>jar</packaging>
    <name>app</name>
    <description>Punto de arranque del monolito: ensambla todos los modulos</description>

    <dependencies>
        <!-- Ya llega transitiva; explícita para que report-aggregate de JaCoCo incluya common -->
        <dependency>
            <groupId>co.eci</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>co.eci</groupId>
            <artifactId>auth-perfil</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>co.eci</groupId>
            <artifactId>salas-equipos</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>co.eci</groupId>
            <artifactId>gameplay-scoreboard</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>co.eci</groupId>
            <artifactId>chat</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>co.eci</groupId>
            <artifactId>estadisticas</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Cobertura agregada de todo el reactor: junta los jacoco.exec de app y de los módulos
               de los que depende, así los tests de integración de app cuentan para controllers, configs
               y adapters de los otros módulos. Queda en app/target/site/jacoco-aggregate/ (lo lee Sonar). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <includeCurrentProject>true</includeCurrentProject>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
