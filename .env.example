DB_HOST=localhost
DB_PORT=5432
DB_NAME=escaperoom_c15
DB_USERNAME=cambiar_usuario
DB_PASSWORD=cambiar_clave
# Puerto de Postgres desde tu máquina (5433 para no chocar con un Postgres local)
DB_HOST_PORT=5433

# Puerto del back desde tu máquina
BACK_PORT=8080

# Partida
PARTIDA_DURACION=5m
# 5 s de aviso en el front + 20 s de juego
RETO_DURACION=25s

# RabbitMQ (broker de los topics STOMP)
RABBIT_USUARIO=cambiar_usuario
RABBIT_CLAVE=cambiar_clave

# Redis (estado vivo compartido entre instancias)
REDIS_CLAVE=cambiar_clave
